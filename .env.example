BOT_TOKEN=123456:ABC...
# ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Адрес панели 3x-ui ВМЕСТЕ с webBasePath, без слэша на конце
# Если бот в Docker, а панель на этом же сервере: http://host.docker.internal:2053/путь
XUI_URL=http://host.docker.internal:2053/mypanel
XUI_USERNAME=admin
XUI_PASSWORD=admin
# ID inbound'а (число в списке подключений панели), в который добавляются клиенты
XUI_INBOUND_ID=1
# Для VLESS + Reality обычно xtls-rprx-vision, иначе оставьте пустым
XUI_FLOW=
XUI_VERIFY_SSL=false

# Базовый URL подписки (Настройки панели -> Подписка), без subId на конце
SUB_BASE_URL=http://5.35.94.202:2096/sub

TRIAL_DAYS=3
TRIAL_GB=5

# --- Оплата картой через Telegram Payments (необязательно) ---
# Токен провайдера: @BotFather -> /mybots -> ваш бот -> Payments -> выбрать провайдера (ЮKassa и др.)
# Сначала подключите тестовый режим провайдера. Пусто = способ скрыт.
PAYMENT_PROVIDER_TOKEN=
CARD_CURRENCY=RUB

# --- Оплата криптой через CryptoBot (необязательно) ---
# Токен: @CryptoBot -> Crypto Pay -> Create App. Пусто = способ скрыт.
CRYPTO_PAY_TOKEN=
# Тестовая сеть (@CryptoTestnetBot): https://testnet-pay.crypt.bot/api
CRYPTO_PAY_API=https://pay.crypt.bot/api
